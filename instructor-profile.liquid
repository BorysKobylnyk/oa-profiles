{% comment %} Scoped Styles - Production Ready {% endcomment %}
{% style %}
  /* Design System Variables */
  :root {
    --ip-brand-primary: #ec1a2a;
    --ip-brand-primary-hover: #d91625;
    --ip-brand-navy: #211f44;
    --ip-brand-navy-hover: #1a1736;
    --ip-surface: #ffffff;
    --ip-surface-subdued: #f7f7f7;
    --ip-background: #f1f1f1;
    --ip-text: #202223;
    --ip-text-subdued: #6d7175;
    --ip-text-disabled: #8c9196;
    --ip-border: #e1e3e5;
    --ip-box-shadow: 0 0.3125rem 0.3125rem -0.15625rem rgba(0, 0, 0, 0.03)
    , 0 0.1875rem 0.1875rem -0.09375rem rgba(0, 0, 0, 0.02)
    , 0 0.125rem 0.125rem -0.0625rem rgba(0, 0, 0, 0.02)
    , 0 0.0625rem 0.0625rem -0.03125rem rgba(0, 0, 0, 0.03)
    , 0 0.03125rem 0.03125rem 0 rgba(0, 0, 0, 0.04)
    , 0 0 0 0.0625rem rgba(0, 0, 0, 0.06);
    --ip-space-1: clamp(0.2rem, 0.071vw + 0.186rem, 0.25rem);
    --ip-space-2: clamp(0.4rem, 0.143vw + 0.371rem, 0.5rem);
    --ip-space-3: clamp(0.5rem, 0.357vw + 0.429rem, 0.75rem);
    --ip-space-4: clamp(0.8rem, 0.286vw + 0.743rem, 1rem);
    --ip-space-5: clamp(1.2rem, 0.071vw + 1.186rem, 1.25rem);
    --ip-space-6: clamp(1.25rem, 0.357vw + 1.179rem, 1.5rem);
    --ip-space-8: clamp(1.8rem, 0.286vw + 1.743rem, 2rem);
    --ip-space-10: clamp(2.25rem, 0.357vw + 2.179rem, 2.5rem);
    --ip-space-12: clamp(2.5rem, 0.714vw + 2.357rem, 3rem);
    --ip-radius-sm: 0;
    --ip-radius-md: 0;
    --ip-radius-lg: 0;
    --ip-radius-full: 9999px;
    --ip-shadow-card: 0 0 0 1px rgba(63, 63, 68, 0.05)
    , 0 1px 3px 0 rgba(63, 63, 68, 0.15);
    --ip-shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.1)
    , 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    --ip-font-size-sm: clamp(0.7rem, 0.161vw + 0.668rem, 0.8125rem);
    --ip-font-size-base: clamp(0.8rem, 0.107vw + 0.779rem, 0.875rem);
    --ip-font-size-md: clamp(0.8rem, 0.286vw + 0.743rem, 1rem);
    --ip-font-size-lg: clamp(1rem, 0.179vw + 0.964rem, 1.125rem);
    --ip-transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --ip-transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Base Styles */
  .instructor-profile {
    line-height: 1.5;
    color: var(--ip-text);
  }

  .instructor-profile__container {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(var(--ip-space-4), 5vw, var(--ip-space-8));
  }

  /* Error State */
  .instructor-profile--error {
    padding: var(--ip-space-12) 0;
  }

  .instructor-profile__error {
    background-color: var(--ip-surface-subdued);
    border: 2px solid var(--ip-border);
    border-radius: var(--ip-radius-lg);
    padding: var(--ip-space-8);
    text-align: center;
  }

  .instructor-profile__error p {
    margin: 0;
    color: var(--ip-text-subdued);
    font-size: var(--ip-font-size-md);
  }

  /* Hero Section */
  .instructor-profile__hero {
    background-color: var(--ip-brand-navy);
    color: var(--ip-surface);
  }

  .instructor-profile__hero-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 990px) {
    .instructor-profile__hero-grid {
      grid-template-columns: 320px 1fr;
      gap: clamp(3rem, 5vw, 4rem);
    }
  }

  /* Profile Image Section */
  .instructor-profile__hero-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    /* No gap needed since social moved to content */
  }

  .instructor-profile__image-wrapper {
    position: relative;
    width: fit-content;
  }

  .instructor-profile__image-border {
    position: relative;
    border-radius: var(--ip-radius-full);
    padding: 12px;
    background: var(--ip-surface);
    box-shadow: var(--ip-shadow-lg);
  }

  /* Red Arc Accent - Rotated to top */
  .instructor-profile__image-border::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--ip-radius-full);
    border: 12px solid transparent;
    border-top-color: var(--ip-brand-primary);
    pointer-events: none;
  }

  .instructor-profile__image {
    border-radius: var(--ip-radius-full);
    object-fit: cover;
    aspect-ratio: 1;
    display: block;
    transition: transform var(--ip-transition);
  }

  .instructor-profile__image:hover {
    transform: scale(1.02);
  }

  /* Social Links - Now positioned in hero content */
  .instructor-profile__social {
    width: 100%;
  }

  .instructor-profile__social-list {
    display: flex;
    gap: var(--ip-space-2);
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 990px) {
    .instructor-profile__social-list {
      justify-content: flex-start;
    }
  }

  .instructor-profile__social-list li {
    margin: 0;
  }

  .instructor-profile__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    /* WCAG touch target */
    height: 44px;
    /* WCAG touch target */
    color: var(--ip-surface);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--ip-radius-md);
    text-decoration: none;
    transition: all var(--ip-transition);
  }

  .instructor-profile__social-link:hover,
  .instructor-profile__social-link:focus-visible {
    background: var(--ip-brand-primary);
    border-color: var(--ip-brand-primary);
    box-shadow: 0 4px 12px rgba(236, 26, 42, 0.3);
  }

  .instructor-profile__social-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Hero Content - Text Information */
  .instructor-profile__hero-content {
    text-align: center;
  }

  @media (min-width: 990px) {
    .instructor-profile__hero-content {
      text-align: left;
    }
  }

  .instructor-profile__hero-header {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  /* Level Badges Container */
  .instructor-profile__level-badges {
    display: flex;
    gap: var(--ip-space-2);
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
  }

  @media (min-width: 990px) {
    .instructor-profile__level-badges {
      justify-content: flex-start;
    }
  }

  /* Name and Title Group - Tight spacing */
  .instructor-profile__name-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Instructor Name - Uses theme's h2 styling */
  .instructor-profile__name {
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  /* Certification Subtitle */
  .instructor-profile__subtitle {
    font-size: var(--ip-font-size-md);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
    margin: 0;
  }

  /* Location Information */
  .instructor-profile__location {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ip-space-2);
    color: var(--ip-brand-primary);
    font-size: var(--ip-font-size-md);
    font-weight: 500;
  }

  @media (min-width: 990px) {
    .instructor-profile__location {
      justify-content: flex-start;
    }
  }

  .instructor-profile__location-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  /* Content Section */
  .instructor-profile__content {
    background-color: var(--ip-background);
    padding-block: var(--ip-space-12);
  }

  .instructor-profile__content-grid {
    display: grid;
    gap: var(--ip-space-6);
  }

  @media (min-width: 990px) {
    .instructor-profile__content-grid {
      grid-template-columns: 1fr 400px;
      gap: var(--ip-space-6);
      align-items: start;
    }
  }

  .instructor-profile__main,
  .instructor-profile__sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--ip-space-6);
  }

  /* Card Component */
  .ip-card {
    background-color: var(--ip-surface);
    box-shadow: var(--ip-box-shadow);
    border-radius: var(--ip-radius-lg);
    overflow: hidden;
    transition: all var(--ip-transition);
  }

  .ip-card--featured {
    box-shadow: 0 0 0 1px var(--ip-brand-primary), var(--ip-shadow-card);
  }

  .ip-card--cta {
    background: linear-gradient(135deg, #fffcfc 0%, var(--ip-surface) 100%);
  }

  .ip-card__header {
    padding: var(--ip-space-5);
    border-bottom: 1px solid var(--ip-border);
    background-color: var(--ip-surface-subdued);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ip-card__header-content {
    display: flex;
    align-items: center;
    gap: var(--ip-space-3);
  }

  .ip-card__icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--ip-brand-primary);
    flex-shrink: 0;
  }

  .ip-card__title {
    font-size: var(--ip-font-size-lg);
    font-weight: 600;
    color: var(--ip-brand-navy);
    margin: 0;
  }

  .ip-card__content {
    padding: var(--ip-space-5);
  }

  .ip-card__content--rich {
    padding: var(--ip-space-6);
  }

  /* Badge Component */
  .ip-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--ip-space-2);
    padding: var(--ip-space-1) var(--ip-space-2);
    background-color: var(--ip-surface-subdued);
    border: 1px solid var(--ip-border);
    border-radius: var(--ip-radius-md);
    font-size: var(--ip-font-size-base);
    line-height: 1.2;
    font-weight: 500;
    color: var(--ip-text);
    transition: all var(--ip-transition-fast);
  }

  .ip-badge__icon {
    width: 1rem;
    height: 1rem;
    color: var(--ip-brand-primary);
    flex-shrink: 0;
  }

  /* Level Badge Variant - Red Background */
  .ip-badge--level {
    background-color: var(--ip-brand-primary);
    border-color: var(--ip-brand-primary);
    color: var(--ip-surface);
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.8125rem);
    font-weight: 600;
  }

  /* Count Badge Variant */
  .ip-badge--count {
    background-color: var(--ip-brand-primary);
    color: var(--ip-surface);
    padding: var(--ip-space-1) var(--ip-space-3);
    border-radius: var(--ip-radius-full);
    font-size: var(--ip-font-size-sm);
    font-weight: 600;
    min-width: 1.4rem;
    height: 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: none;
    flex-shrink: 0;
  }

  /* Badge Group Container */
  .ip-badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ip-space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ip-badge-group li {
    margin: 0;
  }

  /* Biography Content */
  .ip-bio {
    font-size: var(--ip-font-size-md);
    line-height: 1.75;
    color: var(--ip-text);
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .ip-bio > p:first-of-type {
    font-size: var(--ip-font-size-lg);
    font-weight: 500;
    line-height: 1.65;
  }

  .ip-bio p {
    margin-bottom: var(--ip-space-4);
  }

  .ip-bio p:last-child {
    margin-bottom: 0;
  }

  .ip-bio ul,
  .ip-bio ol {
    margin-bottom: var(--ip-space-4);
    padding-left: var(--ip-space-6);
  }

  .ip-bio li {
    margin-bottom: var(--ip-space-2);
    color: var(--ip-text-subdued);
  }

  .ip-bio li::marker {
    color: var(--ip-brand-primary);
  }

  .ip-bio strong {
    font-weight: 600;
    color: var(--ip-text);
  }

  .ip-bio a {
    color: var(--ip-brand-primary);
    text-decoration: underline;
    word-break: break-all;
    overflow-wrap: break-word;
    hyphens: auto;
    transition: color var(--ip-transition-fast);
  }

  .ip-bio a:hover {
    color: var(--ip-brand-primary-hover);
  }

  /* Contact Action Buttons */
  .ip-contact-actions {
    display: flex;
    flex-direction: column;
    gap: var(--ip-space-3);
  }

  .ip-action-btn {
    display: flex;
    align-items: center;
    gap: var(--ip-space-3);
    padding: var(--ip-space-4);
    background-color: var(--ip-surface);
    border: 2px solid var(--ip-border);
    border-radius: var(--ip-radius-md);
    text-decoration: none;
    transition: all var(--ip-transition);
    position: relative;
    overflow: hidden;
  }

  /* Gradient overlay appears on hover */
  .ip-action-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--ip-brand-primary), var(--ip-brand-primary-hover));
    opacity: 0;
    transition: opacity var(--ip-transition);
    z-index: 0;
  }

  .ip-action-btn:hover,
  .ip-action-btn:focus-visible {
    border-color: var(--ip-brand-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(236, 26, 42, 0.15);
  }

  .ip-action-btn:hover::before,
  .ip-action-btn:focus-visible::before {
    opacity: 1;
  }

  /* All elements turn white on hover */
  .ip-action-btn:hover .ip-action-btn__icon,
  .ip-action-btn:hover .ip-action-btn__label,
  .ip-action-btn:hover .ip-action-btn__value,
  .ip-action-btn:hover .ip-action-btn__arrow,
  .ip-action-btn:focus-visible .ip-action-btn__icon,
  .ip-action-btn:focus-visible .ip-action-btn__label,
  .ip-action-btn:focus-visible .ip-action-btn__value,
  .ip-action-btn:focus-visible .ip-action-btn__arrow {
    color: var(--ip-surface);
  }

  .ip-action-btn:hover .ip-action-btn__icon,
  .ip-action-btn:focus-visible .ip-action-btn__icon {
    background-color: rgba(255, 255, 255, 0.2);
  }

  .ip-action-btn__icon {
    width: 2rem;
    height: 2rem;
    color: var(--ip-brand-primary);
    background-color: var(--ip-surface-subdued);
    border-radius: var(--ip-radius-md);
    padding: var(--ip-space-1);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: all var(--ip-transition);
  }

  .ip-action-btn__content {
    display: flex;
    flex-direction: column;
    gap: var(--ip-space-1);
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .ip-action-btn__label {
    font-size: var(--ip-font-size-sm);
    font-weight: 600;
    color: var(--ip-text-subdued);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color var(--ip-transition);
  }

  .ip-action-btn__value {
    font-size: var(--ip-font-size-md);
    font-weight: 600;
    color: var(--ip-text);
    word-break: break-all;
    transition: color var(--ip-transition);
  }

  .ip-action-btn__arrow {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--ip-text-disabled);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: all var(--ip-transition);
  }

  .ip-action-btn:hover .ip-action-btn__arrow,
  .ip-action-btn:focus-visible .ip-action-btn__arrow {
    transform: translateX(4px);
  }

  /* Responsive Design */
  @media (max-width: 989px) {
    .instructor-profile__content-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 749px) {
    .instructor-profile__hero-grid {
      text-align: center;
    }

    .ip-card__header,
    .ip-card__content {
      padding: var(--ip-space-4);
    }

    .ip-card__content--rich {
      padding: var(--ip-space-5);
    }
  }

  @media (max-width: 480px) {
    .instructor-profile__container {
      padding-inline: var(--ip-space-4);
    }

    .ip-badge-group,
    .ip-contact-actions {
      gap: var(--ip-space-2);
    }
  }

  /* Accessibility Features */
  @media (prefers-reduced-motion: reduce) {
    .ip-card,
    .ip-badge,
    .ip-action-btn,
    .instructor-profile__social-link,
    .instructor-profile__image {
      transition: none;
    }

    .ip-badge:hover,
    .ip-action-btn:hover,
    .ip-card:hover,
    .instructor-profile__social-link:hover {
      transform: none;
    }

    .ip-action-btn::before {
      transition: none;
    }
  }

  @media (prefers-contrast: high) {
    .ip-card,
    .ip-badge,
    .ip-action-btn {
      border-width: 2px;
    }
  }

  /* Focus States for Keyboard Navigation */
  .ip-action-btn:focus-visible,
  .instructor-profile__social-link:focus-visible {
    outline: 2px solid var(--ip-brand-primary);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(236, 26, 42, 0.2);
  }

  /* Print Optimization */
  @media print {
    .instructor-profile__hero {
      background: white;
      color: black;
      border-bottom: 3px solid black;
    }

    .ip-card {
      page-break-inside: avoid;
      box-shadow: none;
      border: 1px solid black;
    }

    .ip-action-btn__arrow,
    .instructor-profile__social {
      display: none;
    }
  }
{% endstyle %}

