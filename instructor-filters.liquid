{% comment %}
  Instructor Filters Snippet
  Horizontal dropdown-based filters with search and counters
  Prefix: instructor-profiles-*
{% endcomment %}

<div class="instructor-profiles-filters-wrapper">

  <div class="instructor-profiles-filters" data-instructor-filters>

    {% comment %} Country Filter {% endcomment %}
    <div class="instructor-profiles-filter-dropdown" data-filter-type="country">
      <button
        class="instructor-profiles-filter-button"
        aria-haspopup="true"
        aria-expanded="false"
        data-filter-toggle>
        <svg
          class="instructor-profiles-filter-icon"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.8 13.938h-.011a7 7 0 1 0-11.464.144h-.016l.14.171c.1.127.2.251.3.371L12 21l5.13-6.248c.194-.209.374-.429.54-.659l.13-.155Z" />
        </svg>
        <span class="instructor-profiles-filter-label">Country</span>
        <span
          class="instructor-profiles-filter-badge"
          data-filter-badge
          hidden></span>
        <svg
          class="instructor-profiles-filter-arrow"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m8 15 4 4 4-4m0-6-4-4-4 4" />
        </svg>

      </button>

      <div
        class="instructor-profiles-filter-panel"
        data-filter-panel
        hidden>
        <div class="instructor-profiles-filter-panel-inner">

          {% comment %} Filter Search {% endcomment %}
          <div class="instructor-profiles-filter-search">
            <svg
              class="instructor-profiles-filter-search-icon"
              viewBox="0 0 20 20"
              aria-hidden="true">
              <path d="M8 12c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm9.707 4.293l-4.82-4.82C13.585 10.493 14 9.296 14 8c0-3.314-2.686-6-6-6S2 4.686 2 8s2.686 6 6 6c1.296 0 2.493-.415 3.473-1.113l4.82 4.82c.195.195.451.293.707.293s.512-.098.707-.293c.391-.391.391-1.023 0-1.414z" />
            </svg>
            <input
              type="search"
              class="instructor-profiles-filter-search-input"
              placeholder="Search countries"
              aria-label="Search countries"
              data-filter-search
              autocomplete="off">
          </div>

          {% comment %} Filter Options {% endcomment %}
          <div
            class="instructor-profiles-filter-options"
            data-filter-options
            role="group">
            {% comment %} Options populated by JavaScript {% endcomment %}
          </div>

        </div>
      </div>
    </div>

    {% comment %} Specialties Filter {% endcomment %}
    <div class="instructor-profiles-filter-dropdown" data-filter-type="specialties">
      <button
        class="instructor-profiles-filter-button"
        aria-haspopup="true"
        aria-expanded="false"
        data-filter-toggle>
        <svg
          class="instructor-profiles-filter-icon"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg">
          <path
            stroke="currentColor"
            stroke-linecap="square"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19H5a1 1 0 0 1-1-1v-1a3 3 0 0 1 3-3h2m10 1a3 3 0 0 1-3 3m3-3a3 3 0 0 0-3-3m3 3h1m-4 3a3 3 0 0 1-3-3m3 3v1m-3-4a3 3 0 0 1 3-3m-3 3h-1m4-3v-1m-2.121 1.879-.707-.707m5.656 5.656-.707-.707m-4.242 0-.707.707m5.656-5.656-.707.707M12 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
        </svg>
        <span class="instructor-profiles-filter-label">Specialties</span>
        <span
          class="instructor-profiles-filter-badge"
          data-filter-badge
          hidden></span>
        <svg
          class="instructor-profiles-filter-arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m8 15 4 4 4-4m0-6-4-4-4 4" />
        </svg>
      </button>

      <div
        class="instructor-profiles-filter-panel"
        data-filter-panel
        hidden>
        <div class="instructor-profiles-filter-panel-inner">

          <div class="instructor-profiles-filter-search">
            <svg
              class="instructor-profiles-filter-search-icon"
              viewBox="0 0 20 20"
              aria-hidden="true">
              <path d="M8 12c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm9.707 4.293l-4.82-4.82C13.585 10.493 14 9.296 14 8c0-3.314-2.686-6-6-6S2 4.686 2 8s2.686 6 6 6c1.296 0 2.493-.415 3.473-1.113l4.82 4.82c.195.195.451.293.707.293s.512-.098.707-.293c.391-.391.391-1.023 0-1.414z" />
            </svg>
            <input
              type="search"
              class="instructor-profiles-filter-search-input"
              placeholder="Search specialties"
              aria-label="Search specialties"
              data-filter-search
              autocomplete="off">
          </div>

          <div
            class="instructor-profiles-filter-options"
            data-filter-options
            role="group">
            {% comment %} Options populated by JavaScript {% endcomment %}
          </div>

        </div>
      </div>
    </div>

    {% comment %} Level Filter {% endcomment %}
    <div class="instructor-profiles-filter-dropdown" data-filter-type="levels">
      <button
        class="instructor-profiles-filter-button"
        aria-haspopup="true"
        aria-expanded="false"
        data-filter-toggle>
        <svg
          class="instructor-profiles-filter-icon"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 6h8m-8 6h8m-8 6h8M4 16a2 2 0 1 1 3.321 1.5L4 20h5M4 5l2-1v6m-2 0h4" />
        </svg>
        <span class="instructor-profiles-filter-label">Level</span>
        <span
          class="instructor-profiles-filter-badge"
          data-filter-badge
          hidden></span>
        <svg
          class="instructor-profiles-filter-arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m8 15 4 4 4-4m0-6-4-4-4 4" />
        </svg>
      </button>

      <div
        class="instructor-profiles-filter-panel"
        data-filter-panel
        hidden>
        <div class="instructor-profiles-filter-panel-inner">

          <div
            class="instructor-profiles-filter-options"
            data-filter-options
            role="group">
            {% comment %} Options populated by JavaScript {% endcomment %}
          </div>

        </div>
      </div>
    </div>

    {% comment %} Languages Filter {% endcomment %}
    <div class="instructor-profiles-filter-dropdown" data-filter-type="languages">
      <button
        class="instructor-profiles-filter-button"
        aria-haspopup="true"
        aria-expanded="false"
        data-filter-toggle>
        <svg
          class="instructor-profiles-filter-icon"
          viewBox="0 0 20 20"
          aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M7 2a1 1 0 011 1v1h3a1 1 0 110 2H9.578a18.87 18.87 0 01-1.724 4.78c.29.354.596.696.914 1.026a1 1 0 11-1.44 1.389c-.188-.196-.373-.396-.554-.6a19.098 19.098 0 01-3.107 3.567 1 1 0 01-1.334-1.49 17.087 17.087 0 003.13-3.733 18.992 18.992 0 01-1.487-2.494 1 1 0 111.79-.89c.234.47.489.928.764 1.372.417-.934.752-1.913.997-2.927H3a1 1 0 110-2h3V3a1 1 0 011-1zm6 6a1 1 0 01.894.553l2.991 5.982a.869.869 0 01.02.037l.99 1.98a1 1 0 11-1.79.895L15.383 16h-4.764l-.723 1.447a1 1 0 11-1.788-.894l.99-1.98.019-.038 2.99-5.982A1 1 0 0113 8zm-1.382 6h2.764L13 11.236 11.618 14z"
            clip-rule="evenodd" />
        </svg>
        <span class="instructor-profiles-filter-label">Languages</span>
        <span
          class="instructor-profiles-filter-badge"
          data-filter-badge
          hidden></span>
        <svg
          class="instructor-profiles-filter-arrow"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m8 15 4 4 4-4m0-6-4-4-4 4" />
        </svg>
      </button>

      <div
        class="instructor-profiles-filter-panel"
        data-filter-panel
        hidden>
        <div class="instructor-profiles-filter-panel-inner">

          <div class="instructor-profiles-filter-search">
            <svg
              class="instructor-profiles-filter-search-icon"
              viewBox="0 0 20 20"
              aria-hidden="true">
              <path d="M8 12c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm9.707 4.293l-4.82-4.82C13.585 10.493 14 9.296 14 8c0-3.314-2.686-6-6-6S2 4.686 2 8s2.686 6 6 6c1.296 0 2.493-.415 3.473-1.113l4.82 4.82c.195.195.451.293.707.293s.512-.098.707-.293c.391-.391.391-1.023 0-1.414z" />
            </svg>
            <input
              type="search"
              class="instructor-profiles-filter-search-input"
              placeholder="Search languages"
              aria-label="Search languages"
              data-filter-search
              autocomplete="off">
          </div>

          <div
            class="instructor-profiles-filter-options"
            data-filter-options
            role="group">
            {% comment %} Options populated by JavaScript {% endcomment %}
          </div>

        </div>
      </div>
    </div>

  </div>

</div>